python/src/databay/spec.py linguist-generated=true
python/src/databay/error_codes.py linguist-generated=true
python/src/databay/version.py linguist-generated=true
python/src/databay/skill/references/commands.md linguist-generated=true
python/src/databay/skill/references/errors.md linguist-generated=true
